---
import "@/styles/globals.css";
import { PROFILE } from "../content/profileData";

interface Props {
  title?: string;
  description?: string;
  ogImage?: URL | string;
  canonicalURL?: URL;
}

const { title = PROFILE.site.SEO.title, description = PROFILE.site.SEO.description, ogImage, canonicalURL } = Astro.props;
const canonical = canonicalURL ?? new URL(Astro.url.pathname, Astro.site);
const image = new URL(ogImage ?? "/og.png", Astro.site).href;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: PROFILE.name,
  url: PROFILE.website,
  image: new URL("/me.jpg", Astro.site).href,
  jobTitle: "Applied AI Engineer",
  hasOccupation: { "@type": "Occupation", name: "Applied AI Engineer" },
  address: { "@type": "PostalAddress", addressLocality: "New York", addressRegion: "NY", addressCountry: "US" },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Florida International University" },
    { "@type": "CollegeOrUniversity", name: "Vishwakarma University" },
  ],
  knowsAbout: ["AI agents", "Applied AI", "Multi-agent systems", "Human-in-the-loop", "Context engineering", "MCP", "Agno", "Python", "TypeScript"],
  sameAs: [PROFILE.links.github, PROFILE.links.linkedin, PROFILE.links.twitter],
  description: PROFILE.headLine,
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={PROFILE.name} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={canonical} />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#f7f9fb" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b101e" media="(prefers-color-scheme: dark)" />

<link rel="alternate" type="text/plain" title="LLM-readable summary" href="/llms.txt" />
<link rel="sitemap" href="/sitemap.xml" />
<script type="application/ld+json" set:html={JSON.stringify(personLd)} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={PROFILE.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${PROFILE.name} - Applied AI Engineer`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@mustafa_2vec" />
<meta name="twitter:creator" content="@mustafa_2vec" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<script is:inline>
  (function () {
    function resolveTheme() {
      var saved = localStorage.getItem("theme");
      if (saved === "dark" || saved === "light") return saved;
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }
    function apply() {
      document.documentElement.classList.toggle("dark", resolveTheme() === "dark");
    }
    apply();
    document.addEventListener("astro:after-swap", apply);
    // Email is assembled on click so the address never sits in the page source.
    if (!window.__emailHandler) {
      window.__emailHandler = true;
      document.addEventListener("click", function (e) {
        var a = e.target.closest && e.target.closest("[data-email]");
        if (!a) return;
        e.preventDefault();
        var s = a.getAttribute("data-subject");
        location.href = "mailto:" + atob("bXVzdGFmYS56LmVzb29mYWxseUBnbWFpbC5jb20=") + (s ? "?subject=" + encodeURIComponent(s) : "");
      });
    }
  })();
</script>
