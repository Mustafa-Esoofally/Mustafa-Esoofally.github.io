---
import { getCollection } from "astro:content";
import { Button } from "../ui/button";
import { formateLocalMonth } from "../../lib/utils";

const experiences = (await getCollection("experiences")).sort((a, b) => a.data.order - b.data.order);
---

<div class="mt-2 space-y-4">
  {
    experiences.map((exp) => (
      <a href={`/experiences/${exp.id}`} class="group/item -mx-2 block rounded-lg px-2 py-1.5 transition-colors hover:bg-muted/60">
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="m-0 text-base font-semibold group-hover/item:text-primary">
            {exp.data.company}
            <span class="font-normal text-muted-foreground"> · {exp.data.title}</span>
          </h3>
          <p class="text-xs text-muted-foreground shrink-0 tabular-nums">
            {formateLocalMonth(exp.data.startDate)} - {exp.data.endDate ? formateLocalMonth(exp.data.endDate) : "Present"}
          </p>
        </div>
        {exp.data.highlights.length > 0 && (
          <ul class="mt-1 space-y-0.5">
            {exp.data.highlights.map((h) => (
              <li class="relative pl-3 text-sm text-muted-foreground before:absolute before:left-0 before:top-[0.6em] before:h-1 before:w-1 before:rounded-full before:bg-primary">
                {h}
              </li>
            ))}
          </ul>
        )}
      </a>
    ))
  }
  <a href="/experiences">
    <Button variant="link" className="pl-0">Full timeline</Button>
  </a>
</div>
