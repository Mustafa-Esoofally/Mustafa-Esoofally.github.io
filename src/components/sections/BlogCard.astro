---
import { getCollection } from "astro:content";
import { Button } from "../ui/button";
import { MessagesSquare, Plug, ShieldCheck } from "lucide-react";

const items = await getCollection("work");
const bySlug = Object.fromEntries(items.map((i) => [i.id, i]));

const groups = [
  { title: "AgentOS", blurb: "Where agents meet people", Icon: MessagesSquare, slugs: ["chat-interfaces", "human-in-the-loop", "ag-ui", "security"] },
  { title: "SDK", blurb: "What agents know and remember", Icon: Plug, slugs: ["context-engineering", "learning-machines", "excel-knowledge", "google-workspace", "mcp-and-tools", "models"] },
  { title: "Engineering", blurb: "Keeping a fast-moving codebase reliable", Icon: ShieldCheck, slugs: ["ci-review"] },
];
---

<div class="mt-3 grid gap-6 md:grid-cols-3">
  {groups.map(({ title, blurb, Icon, slugs }) => (
    <div>
      <div class="mb-2 flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 text-primary">
          <Icon className="h-4 w-4" />
        </span>
        <div>
          <p class="m-0 text-sm font-semibold leading-tight">{title}</p>
          <p class="m-0 text-xs text-muted-foreground">{blurb}</p>
        </div>
      </div>
      <ul class="m-0 list-none space-y-1 p-0">
        {slugs.map((slug) => bySlug[slug]).filter(Boolean).map((item) => (
          <li>
            <a href={`/work/${item.id}`} class="group/item -mx-2 block rounded-lg px-2 py-1 transition-colors hover:bg-muted/60">
              <span class="block text-sm font-medium group-hover/item:text-primary">{item.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
<a href="/work">
  <Button variant="link" className="mt-2 pl-0">Everything I built at Agno</Button>
</a>
