---
import { getCollection } from "astro:content";
import { Button } from "../ui/button";
import { Lock } from "lucide-react";

interface Props { category?: string; limit?: number; moreLabel?: string; }
const { category = "product", limit = 4, moreLabel = "All projects" } = Astro.props;

const projects = (await getCollection("projects"))
  .filter((p) => p.data.category === category)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, limit);
---

<ul class={`mt-2 m-0 list-none p-0 space-y-1`}>
  {
    projects.map((project) => (
      <li>
        <a href={`/projects/${project.id}`} class="group/item -mx-2 block rounded-lg px-2 py-1.5 transition-colors hover:bg-muted/60">
          <span class="flex items-center gap-1.5 text-base font-semibold group-hover/item:text-primary">
            {project.data.title}
            {project.data.private && <Lock size={12} className="text-muted-foreground" />}
            {project.data.status && <span class="tag rounded-full px-2 py-0.5 text-[11px] font-medium">{project.data.status}</span>}
          </span>
          <span class="block text-sm text-muted-foreground line-clamp-3">{project.data.description}</span>
        </a>
      </li>
    ))
  }
</ul>
{category === "in-progress" && (
  <a href="#contact" data-email data-subject="Early access" class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary underline-offset-4 hover:underline">In progress - reach out for access</a>
)}
{moreLabel && (
  <a href="/projects">
    <Button variant="link" className="pl-0">{moreLabel}</Button>
  </a>
)}
