---
import { Button } from "../ui/button";
import { PROFILE } from "../../content/profileData";
import { Mail } from "lucide-react";
import Brand from "../icons/Brand.astro";

const socials = [
  { href: PROFILE.links.github, label: "GitHub", brand: "github" },
  { href: PROFILE.links.linkedin, label: "LinkedIn", brand: "linkedin" },
  { href: PROFILE.links.twitter, label: "X", brand: "x" },
  { href: PROFILE.links.mail, label: "Email", brand: null },
];
---

<div class="flex h-full w-full gap-6 animate-appear">
  <div class="flex flex-1 flex-col justify-between gap-5">
    <div class="flex flex-col">
      <span class="mb-4 inline-flex w-fit items-center gap-2 rounded-full border px-3 py-1 text-xs text-muted-foreground">
        <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-60"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span></span>
        {PROFILE.status}
      </span>
      <h1 class="m-0 text-3xl font-semibold tracking-tight">Hi, I'm {PROFILE.firstName}.</h1>
      <p class="m-0 mt-2 max-w-xl text-base text-muted-foreground">{PROFILE.headLine}</p>

      <ul class="intro-links m-0 mt-5 grid list-none gap-3 p-0 sm:grid-cols-2">
        {PROFILE.highlights.map((h) => (
          <li class="rounded-xl bg-background/60 p-3">
            <p class="m-0 text-sm font-semibold">{h.title}</p>
            <p class="m-0 mt-0.5 text-sm text-muted-foreground" set:html={h.html} />
          </li>
        ))}
      </ul>
      <p class="m-0 mt-4 text-sm font-medium text-primary">{PROFILE.aboutKicker}</p>
    </div>
    <div class="flex flex-wrap gap-2">
      {socials.map(({ href, label, brand }) => (
        <a href={href} aria-label={label} {...(label === "Email" ? { "data-email": "" } : { target: "_blank", rel: "noopener" })}>
          <Button variant="outline" className="gap-2 transition-colors hover:border-primary hover:text-primary">
            {brand ? <Brand name={brand as any} class="h-4 w-4" /> : <Mail className="h-4 w-4" />}
            <span class="text-sm">{label}</span>
          </Button>
        </a>
      ))}
    </div>
  </div>
  <img
    src="/me-416.webp"
    srcset="/me-208.webp 208w, /me-416.webp 416w"
    sizes="208px"
    width="208"
    height="208"
    fetchpriority="high"
    decoding="async"
    class="hidden lg:block size-52 shrink-0 rounded-2xl object-cover pointer-events-none"
    alt={`Photo of ${PROFILE.name}`}
  />
</div>

<style>
  .intro-links :global(a) {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-decoration-color: hsl(var(--primary));
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .intro-links :global(a:hover) {
    color: hsl(var(--primary));
  }
</style>
