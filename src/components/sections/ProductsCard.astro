---
import { ArrowUpRight, Rocket } from "lucide-react";

const apps = [
  { slug: "scout", name: "Scout", tagline: "Company knowledge agent", points: ["Answers across Slack, Drive, wiki and CRM", "Navigates sources instead of chunk-and-embed", "Keeps its own wiki and CRM up to date"] },
  { slug: "dash", name: "Dash", tagline: "Self-learning data agent", points: ["Business questions in plain English, answered in SQL", "Grounded in schema, rules and past queries", "Analyst and engineer roles with safe access"] },
  { slug: "pal", name: "Pal", tagline: "Personal agent that learns", points: ["Keeps your notes, people and research", "Remembers how you work, run after run", "Keeps your data and its learnings separate"] },
];
---

<div class="mt-3 grid gap-4 md:grid-cols-3">
  {apps.map((a) => (
    <a href={`/projects/${a.slug}`} class="group/item -m-2 flex flex-col rounded-xl p-2 transition-colors hover:bg-muted/60">
      <span class="flex items-center justify-between text-lg font-semibold group-hover/item:text-primary">
        {a.name}
        <ArrowUpRight className="h-4 w-4 text-muted-foreground group-hover/item:text-primary" />
      </span>
      <span class="text-xs uppercase tracking-wider text-muted-foreground">{a.tagline}</span>
      <ul class="m-0 mt-2 space-y-1 pl-4 text-sm">
        {a.points.map((pt) => <li class="list-disc marker:text-primary">{pt}</li>)}
      </ul>
    </a>
  ))}
</div>
<a href="/projects/agentos-templates" class="group/t mt-5 flex items-center gap-3 rounded-xl border border-dashed border-primary/40 p-3 transition-colors hover:border-primary hover:bg-primary/5">
  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary"><Rocket className="h-4 w-4" /></span>
  <span class="text-sm">
    <span class="font-semibold group-hover/t:text-primary">Any model, your cloud.</span>
    <span class="text-muted-foreground"> Each app runs on the AgentOS templates - Railway, AWS or Docker - with Postgres, auth, Slack and evals out of the box.</span>
  </span>
</a>
