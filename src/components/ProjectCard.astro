---
import { Card as ShadcnCard } from "./ui/card";
import { Lock } from "lucide-react";

const { href, heading, subheading, role, tags = [], isPrivate = false } = Astro.props;
---

<a href={href} class="block h-full">
  <ShadcnCard className="group/item flex h-full flex-col gap-2 p-5 shadow-xs transition hover:-translate-y-0.5 hover:border-primary hover:shadow-md">
    <div class="flex items-start justify-between gap-3">
      <h3 class="m-0 text-lg font-semibold leading-snug group-hover/item:text-primary">{heading}</h3>
      {isPrivate && <span title="Private - code not public" class="mt-1 shrink-0 text-muted-foreground"><Lock size={14} aria-label="Private" /></span>}
    </div>
    <p class="m-0 text-sm leading-relaxed">{subheading}</p>
    {role && <p class="m-0 text-xs leading-relaxed text-muted-foreground">{role}</p>}
    <div class="mt-auto flex flex-wrap gap-1 pt-2">
      {tags.slice(0, 5).map((t: string) => (
        <span class="tag rounded border px-1.5 py-0.5 text-[11px] text-muted-foreground">{t}</span>
      ))}
    </div>
  </ShadcnCard>
</a>
