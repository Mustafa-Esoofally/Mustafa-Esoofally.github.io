---
/**
 * Left-to-right flow diagram (stacks vertically on small screens).
 * steps: columns of the flow; mark one `accent` to highlight where my work sits.
 * loop: optional dashed return path drawn under the flow.
 */
interface Step { label: string; title?: string; items: string[]; accent?: boolean }
interface Props { steps: Step[]; loop?: string; caption?: string }
const { steps, loop, caption } = Astro.props;
---

<figure class="not-prose my-8 w-full first:mt-0">
  <div class="rounded-2xl border bg-card p-4 sm:p-5">
    <ol class="m-0 flex list-none flex-col items-stretch gap-2 p-0 md:flex-row md:items-stretch">
      {steps.map((s, i) => (
        <>
          {i > 0 && (
            <li aria-hidden="true" class="flex items-center justify-center text-muted-foreground">
              <svg class="h-5 w-5 rotate-90 md:rotate-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </li>
          )}
          <li class={`flex flex-1 flex-col rounded-xl border p-3 ${s.accent ? "border-primary/60 bg-primary/5" : "bg-background/60"}`}>
            <span class={`text-[11px] font-medium uppercase tracking-wider ${s.accent ? "text-primary" : "text-muted-foreground"}`}>{s.label}</span>
            {s.title && <span class="mt-0.5 text-sm font-semibold">{s.title}</span>}
            <ul class="m-0 mt-2 flex list-none flex-wrap gap-1 p-0">
              {s.items.map((it) => <li class="m-0 rounded-md border bg-card px-1.5 py-0.5 text-xs">{it}</li>)}
            </ul>
          </li>
        </>
      ))}
    </ol>
    {loop && (
      <div class="mt-3 flex items-center gap-2 rounded-lg border border-dashed px-3 py-2 text-xs text-muted-foreground">
        <svg class="h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
        <span>{loop}</span>
      </div>
    )}
  </div>
  {caption && <figcaption class="mt-2 text-center text-xs text-muted-foreground">{caption}</figcaption>}
</figure>
