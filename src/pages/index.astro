---
import BaseLayout from "../layouts/BaseLayout.astro";
import IntroCard from "../components/sections/IntroCard.astro";
import AboutMe from "../components/sections/AboutMe.astro";
import Card from "../components/Card.astro";
import ExperienceCard from "../components/sections/ExperienceCard.astro";
import Projects from "../components/sections/Projects.astro";
import { PROFILE } from "../content/profileData";
import BlogCard from "../components/sections/BlogCard.astro";
import ProductsCard from "../components/sections/ProductsCard.astro";
const SITE = PROFILE.site;
---

<BaseLayout title={SITE.SEO.title} description={SITE.SEO.description}>
  <main
    transition:animate="fade"
    class="relative m-auto grid w-full max-w-6xl gap-2 overflow-hidden p-2 sm:gap-2 sm:p-4 md:grid-cols-2 md:gap-3 md:p-6 lg:grid-cols-12 lg:gap-4"
  >
    <Card
      colSpan="lg:col-span-9 md:col-span-2"
    >
      <IntroCard />
    </Card>
    <Card
      colSpan="lg:col-span-3 md:col-span-2"
      title="At a glance"
    >
      <AboutMe />
    </Card>
    <Card colSpan="lg:col-span-9 md:col-span-2" title="Enterprise apps">
      <ProductsCard />
    </Card>
    <Card colSpan="lg:col-span-3 md:col-span-2" title="In progress">
      <Projects category="in-progress" limit={3} moreLabel="" />
    </Card>
    <Card colSpan="lg:col-span-12 md:col-span-2" title="Built at Agno">
      <BlogCard />
    </Card>
    <Card colSpan="lg:col-span-6 md:col-span-2" title="Experience">
      <ExperienceCard />
    </Card>
    <Card colSpan="lg:col-span-6 md:col-span-2" title="Production systems">
      <Projects category="production" limit={6} moreLabel="All projects" />
    </Card>
    <Card colSpan="lg:col-span-12 md:col-span-2">
      <div id="contact" class="flex scroll-mt-24 flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
        <p class="m-0 text-base"><span class="font-semibold">Always down to chat.</span> <span class="text-muted-foreground">Hiring, exploring or want to build something together - say hi.</span></p>
        <div class="flex flex-col items-start gap-1 sm:items-end">
          <a href="#contact" data-email class="inline-flex items-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90">Email me</a>
          <span class="text-xs text-muted-foreground">{PROFILE.links.emailText}</span>
        </div>
      </div>
    </Card>
  </main>
</BaseLayout>

