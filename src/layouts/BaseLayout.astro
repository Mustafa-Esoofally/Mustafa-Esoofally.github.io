---
import "../styles/fonts.css";
import { ClientRouter } from "astro:transitions";
import HeadSEO from "../components/HeadSEO.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: URL;
  canonicalURL?: URL;
}

import { PROFILE } from "../content/profileData";
const { title: rawTitle, description, ogImage, canonicalURL } = Astro.props;
const title = !rawTitle ? PROFILE.site.SEO.title : rawTitle.includes(PROFILE.name) ? rawTitle : `${rawTitle} - ${PROFILE.name}`;
---

<html lang="en" class="scroll-smooth">
  <head>
    <HeadSEO
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased ">
    <div class="flex flex-col items-center justify-center">
      <Header />
      <slot />
      <Footer />
    </div>
  </body>
</html>
